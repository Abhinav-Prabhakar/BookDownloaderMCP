# Copy to .env and adjust as needed. Never commit real secrets.
# Every variable is optional; the defaults below are what the server uses.

# Where downloaded books are saved (~ is expanded)
LIBGEN_DOWNLOAD_DIR=~/Books

# Pin a LibGen+ mirror instead of discovering one automatically
# LIBGEN_MIRROR=https://libgen.li/

# Remote JSON listing the current mirrors
# LIBGEN_CONFIG_URL=https://raw.githubusercontent.com/obsfx/libgen-downloader/configuration/config.v3.json

# Per-request timeout in milliseconds
# LIBGEN_TIMEOUT_MS=30000

# Retries for 429/5xx/network failures
# LIBGEN_MAX_RETRIES=2

# Per-file size cap in megabytes
# LIBGEN_MAX_DOWNLOAD_MB=512

# Parallel downloads for libgen_bulk_download (1-5)
# LIBGEN_CONCURRENCY=2

# Verify downloads against the LibGen MD5
# LIBGEN_VERIFY_MD5=true

# How long to cache the mirror list, in milliseconds
# LIBGEN_CONFIG_TTL_MS=3600000
