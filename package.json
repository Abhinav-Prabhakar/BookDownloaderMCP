{
  "name": "book-downloader-mcp",
  "version": "3.0.3",
  "description": "Programmatic LibGen+ search and downloader with an MCP server for LLM tool-calls.",
  "main": "./build/src/index.js",
  "bin": {
    "libgen-mcp": "./bin/mcp.js"
  },
  "homepage": "https://github.com/CodeDreamer06/BookDownloaderMCP",
  "scripts": {
    "start:mcp": "ts-node src/mcp/server.ts",
    "build": "tsc -b",
    "build:mcp": "tsc -b && node ./build/src/mcp/server.js",
    "watch": "tsc -b --watch",
    "test": "jest",
    "test:ci": "jest --ci",
    "prepublishOnly": "npm run build",
    "lint": "eslint 'src/**/*.{js,jsx,ts,tsx,json}'",
    "lint:fix": "eslint --fix 'src/**/*.{js,jsx,ts,tsx,json}'",
    "format": "prettier --write 'src/**/*.{js,jsx,ts,tsx,css,md,json}' --config ./.prettierrc",
    "rimraf": "rimraf ./build && rimraf ./standalone-executables"
  },
  "keywords": [
    "libgen",
    "downloader",
    "libgen+",
    "mcp",
    "llm",
    "search",
    "download"
  ],
  "author": "Omercan Balandi<balandiomer@gmail.com>",
  "license": "WTFPL",
  "repository": {
    "type": "git",
    "url": "https://github.com/CodeDreamer06/BookDownloaderMCP.git"
  },
  "devDependencies": {
    "@types/content-disposition": "0.5.5",
    
    "@types/node": "^18.19.39",
    "@types/node-fetch": "2.5.7",
    "@typescript-eslint/eslint-plugin": "6.7.0",
    "@typescript-eslint/parser": "6.7.0",
    "eslint": "8.19.0",
    "eslint-config-prettier": "8.5.0",
    "eslint-plugin-prettier": "4.2.1",
    "prettier": "2.5.1",
    "rimraf": "5.0.5",
    "ts-node": "10.9.1",
    "typescript": "5.2.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "@types/jest": "^29.5.5",
    "dotenv": "^16.4.5",
    "@types/jsdom": "21.1.3",
    "nock": "^13.5.0"
  },
  "files": ["build", "bin"],
  "engines": { "node": ">=16" },
  "dependencies": {
    "content-disposition": "0.5.4",
    "jsdom": "22.1.0",
    "nanoid": "3.1.23",
    "node-fetch": "2.6.0",
    "@modelcontextprotocol/sdk": "^1.18.2",
    "zod": "^3.22.4"
  }
}
