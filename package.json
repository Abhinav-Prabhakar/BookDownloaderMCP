{
  "name": "book-downloader-mcp",
  "version": "4.0.0",
  "description": "Search Library Genesis (LibGen+) and download ebooks from any MCP client, with MD5 verification and automatic mirror failover.",
  "keywords": [
    "libgen",
    "library-genesis",
    "books",
    "ebooks",
    "mcp",
    "model-context-protocol",
    "downloader",
    "llm",
    "ai",
    "claude",
    "cursor"
  ],
  "homepage": "https://github.com/Abhinav-Prabhakar/BookDownloaderMCP#readme",
  "bugs": {
    "url": "https://github.com/Abhinav-Prabhakar/BookDownloaderMCP/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Abhinav-Prabhakar/BookDownloaderMCP.git"
  },
  "license": "WTFPL",
  "author": "Ömercan Balandı <balandiomer@gmail.com>",
  "contributors": [
    "Abhinav Prabhakar <85114885+Abhinav-Prabhakar@users.noreply.github.com>"
  ],
  "mcpName": "io.github.abhinav-prabhakar/book-downloader-mcp",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "libgen-mcp": "./dist/cli.js",
    "book-downloader-mcp": "./dist/cli.js"
  },
  "files": [
    "dist",
    "server.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/cli.ts",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:live": "RUN_LIVE_TESTS=1 vitest run tests/live.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "jsdom": "^27.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^24.10.1",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^9.39.1",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^5.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
